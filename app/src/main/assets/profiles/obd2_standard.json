      "id": "std_speed",
      "name": "Скорость",
      "unit": "км/ч",
      "group": "live",
      "request": "speed",
      "expr": "b(2)",
      "decimals": 0
    },
    {
      "id": "std_voltage",
      "name": "Напряжение бортсети 12 В",
      "unit": "В",
      "group": "live",
      "request": "voltage",
