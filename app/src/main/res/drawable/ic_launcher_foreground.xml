<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- дорожка круговой шкалы -->
    <path
        android:pathData="M32.8,75.2A30,30 0,1 1,75.2,75.2"
        android:strokeWidth="4"
        android:strokeColor="#33FFFFFF"
        android:strokeLineCap="round" />

    <!-- заполненная часть шкалы -->
    <path
        android:pathData="M32.8,75.2A30,30 0,1 1,80,39"
        android:strokeWidth="4.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="75"
                android:endX="80"
                android:endY="35"
                android:type="linear">
                <item android:offset="0" android:color="#FF2EE6A6" />
                <item android:offset="1" android:color="#FF4CC9F0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- точка на конце шкалы -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M80,39m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0" />

    <!-- молния -->
    <path android:pathData="M58.5,30L42,57L51.5,57L48,78L66,49L56.5,49Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="30"
                android:endX="54"
                android:endY="78"
                android:type="linear">
                <item android:offset="0" android:color="#FF7CF5C8" />
                <item android:offset="1" android:color="#FF4CC9F0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
